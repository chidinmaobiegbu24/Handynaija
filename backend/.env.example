# HandyNaija backend environment variables
# Copy this file to .env and fill in your values.

# Runtime environment: "development" or "production".
# In production MONGODB_URI is required and a failed connection aborts startup.
# Render deployments are detected automatically via the RENDER variable.
ENVIRONMENT=development

# API server
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# MongoDB
# Local development default. In production set MONGODB_URI to the MongoDB
# Atlas connection string in the service environment (never commit real values).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=handynaija

# NIN verification provider
# Fill these in when an authorized identity-verification provider is chosen.
# Never hard-code API keys in the code.
NIN_VERIFICATION_API_KEY=
NIN_VERIFICATION_API_URL=

# Shared secret an authorized provider must send in the X-Webhook-Secret
# header. While it is empty the webhook stays disabled (503 NOT CONFIGURED).
NIN_WEBHOOK_SECRET=

# Cloudinary image storage for profile pictures.
# Create a free Cloudinary account and copy the three values. Never commit
# them - set them in the backend service environment (Render dashboard) and
# keep the local .env out of source control.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Cloudinary tuning (safe defaults are used when left empty):
# Folder inside Cloudinary that profile pictures are uploaded to.
CLOUDINARY_UPLOAD_FOLDER=handynaija/profile-pictures
# Maximum accepted profile image size in bytes (default 5 MB = 5242880).
PROFILE_IMAGE_MAX_BYTES=
# Comma-separated allowed MIME types (default: image/jpeg,image/png,image/webp).
PROFILE_IMAGE_ALLOWED_TYPES=
